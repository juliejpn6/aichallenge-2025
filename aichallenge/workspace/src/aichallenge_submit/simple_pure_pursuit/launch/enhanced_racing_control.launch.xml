<launch>
  <arg name="use_sim_time" default="false"/>
  
  <!-- 高度レーシング制御システム -->
  <node pkg="simple_pure_pursuit" exec="enhanced_racing_control" 
        name="enhanced_racing_control" output="screen">
    
    <!-- 設定ファイル読み込み -->
    <param from="$(find-pkg-share simple_pure_pursuit)/config/enhanced_racing_config.yaml"/>
    
    <!-- 33秒台達成用最適パラメータ -->
    <param name="max_lateral_g" value="0.82"/>
    <param name="enable_advanced_control" value="true"/>
    <param name="enable_debug_output" value="true"/>
    
    <!-- トピック接続 -->
    <remap from="input/kinematics" to="/localization/kinematic_state"/>
    <remap from="input/trajectory" to="/planning/scenario_planning/trajectory"/>
    <remap from="output/control_cmd" to="/control/command/control_cmd"/>
    <remap from="output/raw_control_cmd" to="/control/debug/raw_control_cmd"/>
    <remap from="output/lookahead_point" to="/control/debug/lookahead_point"/>
    <remap from="output/strategy_info" to="/control/debug/strategy_info"/>
  </node>
  
  <!-- 従来システム無効化（コメントアウト） -->
  <!-- <node pkg="simple_pure_pursuit" exec="simple_pure_pursuit" name="simple_pure_pursuit"/> -->
  
</launch>
